#!/usr/bin/env python3
"""Switch the VS Code color theme for a light/dark theme.

Only the `workbench.colorTheme` value is replaced, so the rest of
settings.json (comments, formatting, other settings) is left untouched.

    vscode-theme light   -> GitHub Light
    vscode-theme dark    -> GitHub Dark
"""

import os
import re
import sys

THEMES = {"light": "GitHub Light", "dark": "GitHub Dark"}

SETTINGS_CANDIDATES = [
    "~/.config/Code/User/settings.json",
    "~/.config/Code - OSS/User/settings.json",
    "~/.config/VSCodium/User/settings.json",
    "~/.var/app/com.visualstudio.code/config/Code/User/settings.json",
]


def find_settings():
    for path in SETTINGS_CANDIDATES:
        full = os.path.expanduser(path)
        if os.path.isfile(full):
            return full
    sys.exit("error: VS Code settings.json not found")


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in THEMES:
        sys.exit("usage: vscode-theme light|dark")
    theme = THEMES[sys.argv[1]]
    path = find_settings()

    with open(path, encoding="utf-8") as fh:
        text = fh.read()

    pattern = re.compile(r'("workbench\.colorTheme"\s*:\s*)"[^"]*"')
    if pattern.search(text):
        text = pattern.sub(lambda m: m.group(1) + '"' + theme + '"', text, count=1)
    else:
        idx = text.rfind("}")
        head = text[:idx].rstrip()
        if not head.endswith("{") and not head.endswith(","):
            head += ","
        text = head + f'\n    "workbench.colorTheme": "{theme}"\n}}\n'

    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    print(f"vscode: set colorTheme to '{theme}'")


if __name__ == "__main__":
    main()
